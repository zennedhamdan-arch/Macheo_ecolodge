# Macheo Ecolodge & Camping — environment
# Copy to .env.local for local development; on Vercel, set the same two
# variables in the project settings.

# Supabase project → Settings → API.
# Only the ANON key is ever used. Never put a service-role key here:
# the site deliberately has none — authorization lives in Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the official public domain, used to resolve absolute OG and
# canonical URLs (metadataBase). Leave unset until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile — OPTIONAL spam protection for the reservation and
# contact forms. Leave both empty and the forms simply work without a
# captcha (right for a demo): the API routes still validate every field,
# still write with the anon key, and RLS plus the column grants still apply.
# Set BOTH keys to turn the check on; setting only the site key (widget
# renders, no secret to verify with) fails CLOSED and blocks submissions
# rather than silently trusting an unverified token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
