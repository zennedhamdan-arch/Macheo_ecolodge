# Macheo Ecolodge & Camping — environment
# Copy to .env.local for local development; on Vercel, set the same two
# variables in the project settings.

# Supabase project → Settings → API.
# Only the ANON key is ever used. Never put a service-role key here:
# the site deliberately has none — authorization lives in Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: the official public domain, used to resolve absolute OG and
# canonical URLs (metadataBase). Leave unset until the domain is confirmed.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile (spam protection for the reservation and contact
# forms). The check fails CLOSED: without these keys, form submissions are
# refused rather than silently unprotected, and the forms say so. Set both
# before going live.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
